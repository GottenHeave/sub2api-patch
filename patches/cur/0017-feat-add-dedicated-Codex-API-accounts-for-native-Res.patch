diff --git a/backend/internal/handler/codex_api_gateway.go b/backend/internal/handler/codex_api_gateway.go
new file mode 100644
index 0000000000000000000000000000000000000000..c3b3ac84cdc2aa31fbb46f0a03fa86112fe2a477
