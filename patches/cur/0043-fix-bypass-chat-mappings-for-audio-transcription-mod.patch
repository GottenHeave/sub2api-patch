-		ctx,
+		audioSelectionCtx,
 		groupID,
 		"",
 		sessionHash,
@@ -2196,20 +2204,22 @@ func (s *OpenAIGatewayService) SelectAccountWithSchedulerForAudioTranscriptions(
 		false,
 	)
 	if err == nil {
-		return selection, decision, requestedModel, nil
+		selectionModel := requestedModel
+		if openAIAudioTranscriptionModelSupportBypassed(audioSelectionCtx) &&
+			selection != nil && selection.Account != nil &&
+			!selection.Account.IsModelSupported(requestedModel) {
+			selectionModel = fallbackModel
+		}
+		return selection, decision, selectionModel, nil
 	}
 	if s.checkChannelPricingRestriction(ctx, groupID, requestedModel) {
 		return nil, decision, requestedModel, err
 	}
-	fallbackModel := OpenAIAudioTranscriptionsAccountSelectionModel(requestedModel)
-	if fallbackModel == "" && strings.EqualFold(strings.TrimSpace(requestedModel), OpenAIAudioTranscriptionsDefaultModel) {
-		fallbackModel = OpenAIAudioTranscriptionsDefaultModel
-	}
 	if fallbackModel == "" {
 		return nil, decision, requestedModel, err
 	}
 	fallbackSelection, fallbackDecision, fallbackErr := s.SelectAccountWithSchedulerForAccountType(
-		withOpenAIAudioTranscriptionModelSupportBypass(ctx),
+		audioSelectionCtx,
 		groupID,
 		"",
