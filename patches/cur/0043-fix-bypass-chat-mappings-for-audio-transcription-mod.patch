 ) (*AccountSelectionResult, OpenAIAccountScheduleDecision, string, error) {
+	fallbackModel := OpenAIAudioTranscriptionsAccountSelectionModel(requestedModel)
+	// Audio model names are valid upstream transcription models even when an
+	// account's model_mapping only describes its text-model aliases. Keep the
+	// mapping out of every audio candidate check, including account switches.
+	audioSelectionCtx := ctx
+	if fallbackModel != "" {
+		audioSelectionCtx = withOpenAIAudioTranscriptionModelSupportBypass(ctx)
+	}
