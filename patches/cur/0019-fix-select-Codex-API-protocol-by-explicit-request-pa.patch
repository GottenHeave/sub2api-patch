From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sub2api-patch automation <actions@users.noreply.github.com>
Date: Mon, 21 Sep 2026 21:07:13 +0000
Subject: [PATCH 19/19] fix: select Codex API protocol by explicit request path

---
 backend/internal/handler/codex_api_gateway.go            | 8 +-------
 backend/internal/handler/codex_api_gateway_test.go       | 9 ++++++---
 backend/internal/server/routes/codex_api_gateway_test.go | 5 ++++-
 3 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/backend/internal/handler/codex_api_gateway.go b/backend/internal/handler/codex_api_gateway.go
index c3b3ac84cdc2aa31fbb46f0a03fa86112fe2a477..9dfd10a8633d47d4c9d562060976086c96dce8ac 100644
--- a/backend/internal/handler/codex_api_gateway.go
+++ b/backend/internal/handler/codex_api_gateway.go
@@ -13,3 +13,2 @@ import (
 	"github.com/Wei-Shaw/sub2api/internal/pkg/logger"
-	"github.com/Wei-Shaw/sub2api/internal/pkg/openai"
 	middleware2 "github.com/Wei-Shaw/sub2api/internal/server/middleware"
@@ -21,2 +20,3 @@ import (
 
+// The caller's path selects the gateway contract, regardless of client identity.
 func codexAPITarget(r *http.Request) string {
@@ -28,5 +28,2 @@ func codexAPITarget(r *http.Request) string {
 		case "/models", "/v1/models":
-			if r.URL.Query().Get("client_version") != "" {
-				return "/backend-api/codex/models"
-			}
 			return "/v1/models"
@@ -41,5 +38,2 @@ func codexAPITarget(r *http.Request) string {
 		case "/responses", "/v1/responses":
-			if openai.IsCodexOfficialClientByHeaders(r.Header.Get("User-Agent"), r.Header.Get("originator")) {
-				return "/backend-api/codex/responses"
-			}
 			return "/v1/responses"
diff --git a/backend/internal/handler/codex_api_gateway_test.go b/backend/internal/handler/codex_api_gateway_test.go
index c1c9315c4110fdc988292d6ebde7dc7998157f3a..2c7eed3ed2c4561a8347040d257e0e7a978e0356 100644
--- a/backend/internal/handler/codex_api_gateway_test.go
+++ b/backend/internal/handler/codex_api_gateway_test.go
@@ -54,3 +54,3 @@ func TestCodexAPIModelsUpstreamAndCancellationReleaseSlots(t *testing.T) {
 			c, _ := gin.CreateTestContext(writer)
-			c.Request = httptest.NewRequest(http.MethodGet, "/models?client_version=client", nil).WithContext(ctx)
+			c.Request = httptest.NewRequest(http.MethodGet, "/backend-api/codex/models?client_version=client", nil).WithContext(ctx)
 			c.Request.Header.Set("Authorization", "Bearer downstream-key")
@@ -110,3 +110,4 @@ func TestCodexAPITarget(t *testing.T) {
 		{"POST", "/v1/responses", "", "/v1/responses"},
-		{"POST", "/responses", "codex_cli_rs", "/backend-api/codex/responses"},
+		{"POST", "/responses", "codex_cli_rs", "/v1/responses"},
+		{"POST", "/v1/responses", "codex_cli_rs", "/v1/responses"},
 		{"POST", "/backend-api/codex/responses", "", "/backend-api/codex/responses"},
@@ -114,3 +115,4 @@ func TestCodexAPITarget(t *testing.T) {
 		{"GET", "/v1/models", "", "/v1/models"},
-		{"GET", "/models?client_version=1", "", "/backend-api/codex/models"},
+		{"GET", "/models?client_version=1", "", "/v1/models"},
+		{"GET", "/v1/models?client_version=1", "codex_cli_rs", "/v1/models"},
 		{"GET", "/backend-api/codex/models", "", "/backend-api/codex/models"},
@@ -123,2 +125,3 @@ func TestCodexAPITarget(t *testing.T) {
 			r.Header.Set("originator", test.originator)
+			r.Header.Set("User-Agent", "codex_cli_rs/1.0")
 			require.Equal(t, test.target, codexAPITarget(r))
diff --git a/backend/internal/server/routes/codex_api_gateway_test.go b/backend/internal/server/routes/codex_api_gateway_test.go
index 94a3733028934ac29c9a3875613b85bd9c98626f..6b737501a89b27e9325bfa346ea8d4888bc3ef9c 100644
--- a/backend/internal/server/routes/codex_api_gateway_test.go
+++ b/backend/internal/server/routes/codex_api_gateway_test.go
@@ -92,3 +92,4 @@ func TestCodexAPIGatewayRoutesDispatchBeforeTransformations(t *testing.T) {
 		{"GET", "/v1/models", "/v1/models"},
-		{"GET", "/models?client_version=any", "/backend-api/codex/models"},
+		{"GET", "/models?client_version=any", "/v1/models"},
+		{"GET", "/v1/models?client_version=any", "/v1/models"},
 		{"GET", "/backend-api/codex/models", "/backend-api/codex/models"},
@@ -99,2 +100,4 @@ func TestCodexAPIGatewayRoutesDispatchBeforeTransformations(t *testing.T) {
 		r.Header.Set("Content-Encoding", "gzip")
+		r.Header.Set("originator", "codex_cli_rs")
+		r.Header.Set("User-Agent", "codex_cli_rs/1.0")
 		w := httptest.NewRecorder()
