diff --git a/backend/internal/service/openai_gateway_response_handling_usage_test.go b/backend/internal/service/openai_gateway_response_handling_usage_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..22dd1d778e5597c9bd0605c257562a3ba9aa5b3c
--- /dev/null
+++ b/backend/internal/service/openai_gateway_response_handling_usage_test.go
@@ -0,0 +1,19 @@
+package service
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+func TestOpenAIUsageFromGJSON_ParsesSingularInputTokenDetails(t *testing.T) {
+	usage, ok := openAIUsageFromGJSON(gjson.Parse(`{
+		"input_tokens": 100,
+		"output_tokens": 5,
+		"input_token_details": {"cached_tokens": 42}
+	}`))
+
+	require.True(t, ok)
+	require.Equal(t, 42, usage.CacheReadInputTokens)
+}
