From 0c1d639a5b9645636d40e89825af8e5fdc5753da Mon Sep 17 00:00:00 2001
From: sub2api-patch automation <actions@users.noreply.github.com>
Date: Sat, 19 Sep 2026 19:04:25 +0000
Subject: [PATCH] test: use virtual time for Gemini comment keepalives

diff --git a/backend/internal/service/gemini_sse_comment_compat_test.go b/backend/internal/service/gemini_sse_comment_compat_test.go
--- a/backend/internal/service/gemini_sse_comment_compat_test.go
+++ b/backend/internal/service/gemini_sse_comment_compat_test.go
@@ -5,6 +5,7 @@ import (
 	"net/http"
 	"strings"
 	"testing"
+	"testing/synctest"
 	"time"
 
 	"github.com/Wei-Shaw/sub2api/internal/config"
@@ -48,6 +49,15 @@
 func runAntigravityGeminiStreamWithIdle(t *testing.T, userAgent string, idle time.Duration) string {
+	t.Helper()
+	var out string
+	synctest.Test(t, func(t *testing.T) {
+		out = runAntigravityGeminiStreamWithIdleInBubble(t, userAgent, idle)
+	})
+	return out
+}
+
+func runAntigravityGeminiStreamWithIdleInBubble(t *testing.T, userAgent string, idle time.Duration) string {
 	t.Helper()
 	gin.SetMode(gin.TestMode)
 	svc := newAntigravityCompatService(
 		config.GatewayConfig{MaxLineSize: defaultMaxLineSize, StreamKeepaliveInterval: 1},
 		nil,
@@ -68,11 +78,15 @@
 		_, err := svc.handleGeminiStreamingResponse(c, resp, time.Now())
 		done <- err
 	}()
+	synctest.Wait()
+	// Offset data from the ticker so the first tick is not yet an idle interval.
+	time.Sleep(100 * time.Millisecond)
 	_, err := io.WriteString(
 		writer,
 		`data: {"response":{"responseId":"resp_1","candidates":[{"content":{"parts":[{"text":"partial"}]}}],"usageMetadata":{"promptTokenCount":8,"candidatesTokenCount":1}}}`+"\n\n",
 	)
 	require.NoError(t, err)
+	synctest.Wait()
 	time.Sleep(idle)
 	require.NoError(t, writer.Close())
 	require.NoError(t, <-done)
