Subject: [PATCH 02/11] build: cache pnpm dependencies with BuildKit

---
 Dockerfile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Dockerfile b/Dockerfile
index adfa4d470..c3d792874 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -42,5 +42,5 @@ RUN --mount=type=cache,id=sub2api-pnpm-store,target=/root/.local/share/pnpm/stor
 COPY frontend/ ./
 COPY docs/legal/ /app/docs/legal/
-RUN pnpm run build
+RUN --mount=type=cache,id=sub2api-pnpm-store,target=/root/.local/share/pnpm/store pnpm run build
 
