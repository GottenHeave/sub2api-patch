From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sub2api-patch automation <actions@users.noreply.github.com>
Date: Mon, 3 Aug 2026 10:44:53 +0000
Subject: [PATCH] fix: align realtime handlers with slot result enum


diff --git a/backend/internal/handler/openai_audio_transcriptions.go b/backend/internal/handler/openai_audio_transcriptions.go
index e81fb6c3d..96173a003 100644
--- a/backend/internal/handler/openai_audio_transcriptions.go
+++ b/backend/internal/handler/openai_audio_transcriptions.go
@@ -158,7 +158,7 @@ func (h *OpenAIGatewayHandler) AudioTranscriptions(c *gin.Context) {
 		setOpsSelectedAccount(c, account.ID, account.Platform)
 
 		accountReleaseFunc, acquired := h.acquireResponsesAccountSlot(c, apiKey.GroupID, sessionHash, selection, false, &streamStarted, reqLog)
-		if !acquired {
+		if acquired != openAISlotAcquireOK {
 			return
 		}
 
diff --git a/backend/internal/handler/openai_realtime_calls.go b/backend/internal/handler/openai_realtime_calls.go
index d3f9f30f9..5e1796036 100644
--- a/backend/internal/handler/openai_realtime_calls.go
+++ b/backend/internal/handler/openai_realtime_calls.go
@@ -165,7 +165,7 @@ func (h *OpenAIGatewayHandler) RealtimeREST(c *gin.Context) {
 		setOpsSelectedAccount(c, account.ID, account.Platform)
 
 		accountReleaseFunc, acquired := h.acquireResponsesAccountSlot(c, apiKey.GroupID, sessionHash, selection, false, &streamStarted, reqLog)
-		if !acquired {
+		if acquired != openAISlotAcquireOK {
 			return
 		}
 
