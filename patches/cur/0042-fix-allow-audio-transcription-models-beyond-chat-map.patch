+func TestOpenAIGatewayService_SelectAccountWithSchedulerForAudioTranscriptions_DefaultModelIgnoresChatModelMapping(t *testing.T) {
+	resetOpenAIAdvancedSchedulerSettingCacheForTest()
+
+	ctx := context.Background()
+	groupID := int64(10111)
+	account := Account{
+		ID:          36032,
+		Platform:    PlatformOpenAI,
+		Type:        AccountTypeAPIKey,
+		Status:      StatusActive,
+		Schedulable: true,
+		Concurrency: 1,
+		Priority:    0,
+		Credentials: map[string]any{
+			"model_mapping": map[string]any{
+				"gpt-5.6-sol": "gpt-5.6-sol",
+			},
+		},
+	}
+	cfg := &config.Config{}
+	cfg.Gateway.Scheduling.LoadBatchEnabled = false
+	svc := &OpenAIGatewayService{
+		accountRepo:        schedulerTestOpenAIAccountRepo{accounts: []Account{account}},
+		cfg:                cfg,
+		concurrencyService: NewConcurrencyService(schedulerTestConcurrencyCache{}),
+	}
+
+	selection, _, selectionModel, err := svc.SelectAccountWithSchedulerForAudioTranscriptions(
+		ctx,
+		&groupID,
+		"",
+		OpenAIAudioTranscriptionsDefaultModel,
+		nil,
+	)
+	require.NoError(t, err)
+	require.NotNil(t, selection)
+	require.NotNil(t, selection.Account)
+	require.Equal(t, account.ID, selection.Account.ID)
+	require.Equal(t, OpenAIAudioTranscriptionsDefaultModel, selectionModel)
+	if selection.ReleaseFunc != nil {
+		selection.ReleaseFunc()
+	}
+}
