@@ -95,6 +95,27 @@ func OpenAIAudioTranscriptionsAccountSelectionModel(model string) string {
 	}
 }
 
+type openAIAudioTranscriptionSelectionContextKey struct{}
+
+// withOpenAIAudioTranscriptionModelSupportBypass marks the last-resort audio
+// selection pass. Transcription models are served by the audio upstream even
+// when an account's model_mapping only lists chat models, so that allowlist
+// must not make every otherwise eligible audio account disappear.
+func withOpenAIAudioTranscriptionModelSupportBypass(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, openAIAudioTranscriptionSelectionContextKey{}, true)
+}
+
+func openAIAudioTranscriptionModelSupportBypassed(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	bypassed, _ := ctx.Value(openAIAudioTranscriptionSelectionContextKey{}).(bool)
+	return bypassed
+}
