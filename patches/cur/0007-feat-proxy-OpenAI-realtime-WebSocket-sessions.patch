+	if !audioResult.Exists() {
+		return aggregate
+	}
+	audioTokens, ok := parseUsageIntField(audioResult, false)
+	if !ok || audioTokens <= 0 {
+		return aggregate
+	}
+	textResult := firstUsageResult(usage, textPaths...)
