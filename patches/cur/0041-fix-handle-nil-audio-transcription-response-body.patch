Subject: [PATCH] fix: handle nil audio transcription response body


diff --git a/backend/internal/service/openai_audio_transcriptions.go b/backend/internal/service/openai_audio_transcriptions.go
index de36beeec..c9be15832 100644
--- a/backend/internal/service/openai_audio_transcriptions.go
+++ b/backend/internal/service/openai_audio_transcriptions.go
@@ -361,6 +361,11 @@ func (s *OpenAIGatewayService) ForwardAudioTranscriptions(
 		}
 		return s.handleErrorResponse(ctx, resp, c, account, forwardBody)
 	}
+	if resp.Body == nil {
+		readErr := errors.New("upstream response body is nil")
+		logOpenAIAudioTranscriptionResponseReadFailure(ctx, account, requestModel, upstreamModel, upstreamReq, resp, readErr)
+		return nil, readErr
+	}
 	defer func() { _ = resp.Body.Close() }()
 
 	body, err := ReadUpstreamResponseBody(resp.Body, s.cfg, c, openAITooLargeError)
diff --git a/backend/internal/service/openai_audio_transcriptions_test.go b/backend/internal/service/openai_audio_transcriptions_test.go
index e61e869bd..6775524b4 100644
--- a/backend/internal/service/openai_audio_transcriptions_test.go
+++ b/backend/internal/service/openai_audio_transcriptions_test.go
@@ -851,6 +851,38 @@ func TestOpenAIAudioTranscriptionNilErrorBodyLogsDiagnostics(t *testing.T) {
 	require.Contains(t, entries[0].Message, "upstream_response_read_failed")
 }
 
+func TestOpenAIAudioTranscriptionNilSuccessBodyLogsDiagnostics(t *testing.T) {
+	body, contentType := buildOpenAIAudioTranscriptionMultipart(t, map[string]string{
+		"model": "gpt-4o-mini-transcribe",
+	}, []byte("fake-audio"))
+	c, _ := newOpenAIAudioTranscriptionTestContext(http.MethodPost, "/v1/audio/transcriptions", body, contentType)
+	upstream := &httpUpstreamRecorder{resp: &http.Response{
+		StatusCode: http.StatusOK,
+		Header: http.Header{
+			"Content-Type": []string{"application/json"},
+			"X-Request-Id": []string{"rid_nil_success_body"},
+		},
+	}}
+	core, logs := observer.New(zap.ErrorLevel)
+	ctx := logger.IntoContext(context.Background(), zap.New(core))
+	svc := &OpenAIGatewayService{
+		cfg:          &config.Config{},
+		httpUpstream: upstream,
+	}
+
+	parsed, err := svc.ParseOpenAIAudioTranscriptionsRequest(c, body)
+	require.NoError(t, err)
+	_, err = svc.ForwardAudioTranscriptions(ctx, c, openAIAudioTranscriptionAPIKeyAccount(12), parsed, "")
+	require.ErrorContains(t, err, "upstream response body is nil")
+
+	entries := logs.FilterMessage("openai.audio_transcriptions.upstream_response_read_failed").All()
+	require.Len(t, entries, 1)
+	assertObservedField(t, entries[0], "account_id", "12")
+	assertObservedField(t, entries[0], "upstream_status_code", "200")
+	assertObservedField(t, entries[0], "upstream_request_id", "rid_nil_success_body")
+	assertObservedField(t, entries[0], "error", "upstream response body is nil")
+}
+
