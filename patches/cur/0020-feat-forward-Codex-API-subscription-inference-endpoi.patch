+func (s *codexAPIRouteCache) SetSessionAccountID(_ context.Context, _ int64, key string, id int64, _ time.Duration) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.resources[key] = id
+	return nil
+}
