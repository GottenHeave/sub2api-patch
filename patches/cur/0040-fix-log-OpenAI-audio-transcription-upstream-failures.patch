+func TestOpenAIGatewayServiceForwardAudioTranscriptions_FailoverLogsDiagnostics(t *testing.T) {
+	body, contentType := buildOpenAIAudioTranscriptionMultipart(t, map[string]string{
+		"model": "gpt-4o-mini-transcribe",
+	}, []byte("fake-audio"))
+	c, _ := newOpenAIAudioTranscriptionTestContext(http.MethodPost, "/v1/audio/transcriptions", body, contentType)
+	upstreamBody := `{"error":{"message":"VoiceInk transcription failed"},"request_id":"upstream-body-id"}`
+	upstream := &httpUpstreamRecorder{resp: newOpenAIAudioTranscriptionResponse(http.StatusInternalServerError, upstreamBody)}
+	cfg := &config.Config{}
+	cfg.Gateway.LogUpstreamErrorBody = true
+	cfg.Gateway.LogUpstreamErrorBodyMaxBytes = 512
+	core, logs := observer.New(zap.WarnLevel)
+	ctx := logger.IntoContext(context.Background(), zap.New(core))
+	svc := &OpenAIGatewayService{
+		cfg:          cfg,
+		httpUpstream: upstream,
+	}
+	account := openAIAudioTranscriptionOAuthAccount(8)
+
+	parsed, err := svc.ParseOpenAIAudioTranscriptionsRequest(c, body)
+	require.NoError(t, err)
+	_, err = svc.ForwardAudioTranscriptions(ctx, c, account, parsed, "")
+
+	var failoverErr *UpstreamFailoverError
+	require.ErrorAs(t, err, &failoverErr)
+	rawEvents, ok := c.Get(OpsUpstreamErrorsKey)
+	require.True(t, ok)
+	events, ok := rawEvents.([]*OpsUpstreamErrorEvent)
+	require.True(t, ok)
+	require.Len(t, events, 1)
+	require.Equal(t, "rid_audio", events[0].UpstreamRequestID)
+	require.Equal(t, chatgptTranscribeURL, events[0].UpstreamURL)
+	require.Equal(t, upstreamBody, events[0].UpstreamResponseBody)
+	require.Equal(t, upstreamBody, events[0].Detail)
+
+	entries := logs.FilterMessage("openai.audio_transcriptions.upstream_error").All()
+	require.Len(t, entries, 1)
+	loggedFields := map[string]string{}
+	for _, field := range entries[0].Context {
+		value := field.String
+		if value == "" && field.Integer != 0 {
+			value = strconv.FormatInt(field.Integer, 10)
+		}
+		loggedFields[field.Key] = value
+	}
+	require.Equal(t, "8", loggedFields["account_id"])
+	require.Equal(t, AccountTypeOAuth, loggedFields["account_type"])
+	require.Equal(t, "gpt-4o-mini-transcribe", loggedFields["request_model"])
+	require.Equal(t, "gpt-4o-mini-transcribe", loggedFields["upstream_model"])
+	require.Equal(t, "500", loggedFields["upstream_status_code"])
+	require.Equal(t, "rid_audio", loggedFields["upstream_request_id"])
+	require.Equal(t, chatgptTranscribeURL, loggedFields["upstream_url"])
+	require.Equal(t, upstreamBody, loggedFields["upstream_response_body"])
+}
+
+func TestOpenAIAudioTranscriptionLogValueRedactsSecrets(t *testing.T) {
+	raw := `Authorization: Bearer sk-proj-1234567890abcdef access_token=oauth-secret https://user:password@example.test/transcribe?token=query-secret`
+
+	got := sanitizeOpenAIAudioTranscriptionLogValue(raw, 2048)
+
+	require.NotContains(t, got, "sk-proj-1234567890abcdef")
+	require.NotContains(t, got, "oauth-secret")
+	require.NotContains(t, got, "password@example.test")
+	require.NotContains(t, got, "query-secret")
+	require.Contains(t, got, "[已脱敏]")
+}
