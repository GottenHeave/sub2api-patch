+func (s *OpenAIGatewayService) openAIAudioTranscriptionErrorDetail(responseBody []byte) string {
+	if s == nil || s.cfg == nil || !s.cfg.Gateway.LogUpstreamErrorBody {
+		return ""
+	}
+	maxBytes := s.cfg.Gateway.LogUpstreamErrorBodyMaxBytes
+	if maxBytes <= 0 || maxBytes > openAIAudioTranscriptionLogValueMaxBytes {
+		maxBytes = openAIAudioTranscriptionLogValueMaxBytes
+	}
+	detail, _ := sanitizeErrorBodyForStorage(string(responseBody), maxBytes)
+	return sanitizeOpenAIAudioTranscriptionLogValue(detail, maxBytes)
+}
+
+func sanitizeOpenAIAudioTranscriptionLogValue(value string, maxBytes int) string {
+	if maxBytes <= 0 {
+		maxBytes = openAIAudioTranscriptionLogValueMaxBytes
+	}
+	value = sanitizeUpstreamErrorMessage(strings.TrimSpace(value))
+	value = redactContentModerationSecrets(value)
+	value = strings.ReplaceAll(value, "\n", "\\n")
+	value = strings.ReplaceAll(value, "\r", "\\r")
+	return truncateString(value, maxBytes)
+}
+
+func safeOpenAIAudioTranscriptionURL(req *http.Request) string {
+	if req == nil || req.URL == nil {
+		return ""
+	}
+	u := *req.URL
+	u.User = nil
+	u.RawQuery = ""
+	u.ForceQuery = false
+	u.Fragment = ""
+	u.RawFragment = ""
+	return safeUpstreamURL(u.String())
+}
+
+func logOpenAIAudioTranscriptionResponseReadFailure(
+	ctx context.Context,
+	account *Account,
+	requestModel string,
+	upstreamModel string,
+	upstreamReq *http.Request,
+	resp *http.Response,
+	err error,
+) {
+	if account == nil || resp == nil || err == nil {
+		return
+	}
+	logger.FromContext(ctx).Error(
+		"openai.audio_transcriptions.upstream_response_read_failed",
+		zap.Int64("account_id", account.ID),
+		zap.String("account_name", strings.TrimSpace(account.Name)),
+		zap.String("account_type", account.Type),
+		zap.String("platform", account.Platform),
+		zap.String("request_model", requestModel),
+		zap.String("upstream_model", upstreamModel),
+		zap.Int("upstream_status_code", resp.StatusCode),
+		zap.String("upstream_request_id", strings.TrimSpace(resp.Header.Get("x-request-id"))),
+		zap.String("upstream_url", safeOpenAIAudioTranscriptionURL(upstreamReq)),
+		zap.String("error", sanitizeOpenAIAudioTranscriptionLogValue(err.Error(), openAIAudioTranscriptionLogValueMaxBytes)),
+	)
+}
