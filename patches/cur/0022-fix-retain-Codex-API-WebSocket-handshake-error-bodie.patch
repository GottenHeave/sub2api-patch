From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sub2api-patch automation <actions@users.noreply.github.com>
Date: Mon, 5 Oct 2026 09:48:36 +0000
Subject: [PATCH 1/1] fix: retain Codex API WebSocket handshake error bodies

---
 backend/internal/service/codex_api_endpoints_test.go |  2 ++
 backend/internal/service/codex_api_websocket.go      | 12 ++++++++++--
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/backend/internal/service/codex_api_endpoints_test.go b/backend/internal/service/codex_api_endpoints_test.go
index a864a21b8b3c5de3e3139e2c517f8a33b080edd3..feaca4a9e4c4cfc6bb100b60aecbf04eda052e08 100644
--- a/backend/internal/service/codex_api_endpoints_test.go
+++ b/backend/internal/service/codex_api_endpoints_test.go
@@ -120,2 +120,4 @@ func TestCodexAPIWebSocketHandshakeAndRedirects(t *testing.T) {
 				w.WriteHeader(status)
+				require.NoError(t, http.NewResponseController(w).Flush())
+				time.Sleep(10 * time.Millisecond)
 				_, _ = io.WriteString(w, body)
diff --git a/backend/internal/service/codex_api_websocket.go b/backend/internal/service/codex_api_websocket.go
index b98e405c67804c161a5d65e8477b0e8c26ab4202..69201ef7652d6910489cee7d885fc4a385e4be17 100644
--- a/backend/internal/service/codex_api_websocket.go
+++ b/backend/internal/service/codex_api_websocket.go
@@ -3,3 +3,5 @@ package service
 import (
+	"bytes"
 	"context"
+	"io"
 	"net/http"
@@ -21,7 +23,13 @@ func (t *codexAPIWSHTTPTransport) RoundTrip(req *http.Request) (*http.Response,
 	if err == nil && resp.StatusCode != http.StatusSwitchingProtocols {
-		// The WebSocket library keeps only 1 KiB of handshake errors. The HTTP
-		// relay owns the original body so provider errors are not truncated.
+		// Dial cancels its handshake context on return and retains only 1 KiB of
+		// errors. Finish reading under that context before handing off the bytes.
+		body, readErr := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
 		copy := *resp
+		copy.Body = io.NopCloser(bytes.NewReader(body))
 		t.rejected = &copy
 		resp.Body = http.NoBody
+		if readErr != nil {
+			return nil, readErr
+		}
 	}
